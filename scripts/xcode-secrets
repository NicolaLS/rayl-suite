#!/usr/bin/env bash
# Mirrors RAYL_BREEZ_API_KEY into Xcode's gitignored Secrets.xcconfig, since Xcode does not see
# shell variables. Run from .envrc after loading secrets. Writes only on change so Xcode does
# not rebuild needlessly; "//" is escaped because xcconfig treats it as a comment.
set -euo pipefail

[[ -n "${RAYL_BREEZ_API_KEY:-}" ]] || exit 0
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
file="$root/app/iosApp/Configuration/Secrets.xcconfig"
line="RAYL_BREEZ_API_KEY = $(printf '%s' "$RAYL_BREEZ_API_KEY" | sed 's#//#/$()/#g')"
if [[ "$(cat "$file" 2>/dev/null)" != "$line" ]]; then
  (umask 077 && printf '%s\n' "$line" > "$file")
fi
