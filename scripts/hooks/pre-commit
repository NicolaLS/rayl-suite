#!/usr/bin/env bash
#
# Pre-commit hook that runs ktlint only for modules containing staged Kotlin.
#
# Install: cp scripts/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

GIT_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=$(
    git diff --cached --name-only --diff-filter=ACMR |
        grep -E '\.kts?$' |
        grep -Ev '(^|/)build/' || true
)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

if [ ! -x "$GIT_ROOT/gradlew" ] || [ ! -f "$GIT_ROOT/settings.gradle.kts" ]; then
    echo -e "${YELLOW}Warning: Gradle wrapper not found; skipping ktlint.${NC}"
    exit 0
fi

TASKS=""
CHECK_BUILD_LOGIC=false

while IFS= read -r file; do
    task=""
    case "$file" in
        build-logic/*)
            CHECK_BUILD_LOGIC=true
            ;;
        *)
            module_dir="$(dirname "$file")"
            while [ "$module_dir" != "." ] && [ ! -f "$GIT_ROOT/$module_dir/build.gradle.kts" ]; do
                module_dir="$(dirname "$module_dir")"
            done
            if [ "$module_dir" = "." ]; then
                task=":ktlintCheck"
            else
                task=":${module_dir//\//:}:ktlintCheck"
            fi
            ;;
    esac

    if [ -n "$task" ]; then
        TASKS="${TASKS}${task}"$'\n'
    fi
done <<< "$STAGED_FILES"

FILE_COUNT=$(printf '%s\n' "$STAGED_FILES" | wc -l | tr -d ' ')
echo -e "${YELLOW}Running affected ktlint checks for ${FILE_COUNT} staged file(s)...${NC}"

if [ -n "$TASKS" ]; then
    SORTED_TASKS=$(printf '%s' "$TASKS" | sed '/^$/d' | sort -u | tr '\n' ' ')
    if ! (
        cd "$GIT_ROOT" || exit 1
        set -f
        # Task names cannot contain whitespace; intentional splitting keeps one Gradle invocation.
        # shellcheck disable=SC2086
        ./gradlew --console=plain $SORTED_TASKS
    ); then
        echo -e "${RED}ktlint failed. Run the affected module's ktlintFormat task and restage.${NC}"
        exit 1
    fi
fi

if [ "$CHECK_BUILD_LOGIC" = true ]; then
    if ! "$GIT_ROOT/gradlew" -p "$GIT_ROOT/build-logic" --console=plain ktlintCheck; then
        echo -e "${RED}build-logic ktlint failed. Run ./gradlew -p build-logic ktlintFormat and restage.${NC}"
        exit 1
    fi
fi

echo -e "${GREEN}ktlint check passed!${NC}"
