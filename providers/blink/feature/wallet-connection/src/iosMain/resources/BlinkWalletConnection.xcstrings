    "add_blink_wallet_connection_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verbinden wird dein API-Schlüssel an Blink gesendet und deine Blink-Kontakte (Namen und Lightning-Adressen) werden auf dieses Gerät importiert. Mit dem Verbinden akzeptierst du die Nutzungsbedingungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecting sends your API key to Blink and imports your Blink contacts (names and Lightning addresses) onto this device. By connecting, you accept the Terms of Use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al conectar, tu clave API se envía a Blink y tus contactos de Blink (nombres y direcciones Lightning) se importan a este dispositivo. Al conectar, aceptas los Términos de uso."
          }
        }
      }
    },
    "add_blink_wallet_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den im Blink-Dashboard erstellten API-Schlüssel ein. %1$@ speichert ihn sicher auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the API key you created in the Blink dashboard. %1$@ stores it securely on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la clave API que creaste en el panel de Blink. %1$@ la guarda de forma segura en este dispositivo."
          }
        }
      }
    },
