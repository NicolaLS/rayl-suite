    "settings_blink_connection_remove_description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ entfernt den gespeicherten API-Schlüssel von diesem Gerät. Du musst die Wallet erneut verbinden, bevor du Zahlungen senden kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will remove the saved API key from this device. You will need to connect again before making payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ eliminará la clave API guardada en este dispositivo. Tendrás que volver a conectarla antes de realizar pagos."
          }
        }
      }
    },
