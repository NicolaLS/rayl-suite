        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave API inválida o revocada. Crea una nueva clave para continuar."
          }
        }
      }
    },
    "error_blink_invalid_invoice" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Rechnung scheint ungültig oder beschädigt zu sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This invoice appears to be invalid or corrupted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta factura parece ser inválida o estar corrupta."
          }
        }
      }
    },
    "error_blink_invoice_expired" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
