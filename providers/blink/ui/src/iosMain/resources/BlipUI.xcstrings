    "error_blink_rate_limited" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen. Bitte warte einen Moment und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests. Please wait a moment and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Espera un momento e intenta de nuevo."
          }
        }
      }
    },
    "error_blink_required_permissions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deinen API-Schlüssel müssen Lesen und Schreiben aktiviert sein. Erstelle im Blink-Dashboard einen neuen Schlüssel mit beiden Berechtigungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your API key must have Read and Write enabled. Create a new key in the Blink dashboard with both permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave API debe tener Lectura y Escritura activadas. Crea una nueva clave en el panel de Blink con ambos permisos."
          }
        }
      }
    },
    "error_blink_route_not_found" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte keine Route für diese Zahlung gefunden werden. Der Empfänger ist möglicherweise offline oder nicht erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not find a route to complete this payment. The recipient may be offline or unreachable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró una ruta para completar este pago. El destinatario puede estar desconectado o inalcanzable."
          }
        }
      }
    },
    "error_blink_self_payment" : {
      "extractionState" : "stale",
      "localizations" : {
