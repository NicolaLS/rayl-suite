    "connect_wallet_required_methods": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt pay_invoice und lookup_invoice, bevor diese Verbindung gespeichert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ requires both pay_invoice and lookup_invoice before this connection can be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ requiere pay_invoice y lookup_invoice antes de guardar esta conexión."
          }
        }
      }
    },
