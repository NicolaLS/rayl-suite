{
  "sourceLanguage": "en",
  "strings": {
    "add_wallet_description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere eine NWC-URI und kehre hierher zurück oder scanne den QR-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy a NWC URI and come back here, or scan the QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un URI de NWC y regresa aquí, o escanea el código QR."
          }
        }
      }
    },
    "add_wallet_scan_allow_camera": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Camera Access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso a la cámara"
          }
        }
      }
    },
    "add_wallet_scan_instruction": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den QR-Code. Der Scan funktioniert ohne Kameravorschau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your camera at the QR code. Scanning works without a camera preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al código QR. El escaneo funciona sin vista previa de la cámara."
          }
        }
      }
    },
    "add_wallet_scan_open_settings": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        }
      }
    },
    "add_wallet_scan_permission": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Scannen von QR-Codes ist Kamerazugriff erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to scan QR codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la cámara para escanear códigos QR."
          }
        }
      }
    },
    "add_wallet_scan_restricted": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aufgrund der Einschränkungen dieses Geräts nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is unavailable because of this device’s restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara no está disponible debido a las restricciones de este dispositivo."
          }
        }
      }
    },
    "add_wallet_scan_retry": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentar de nuevo"
          }
        }
      }
    },
    "add_wallet_scan_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not start. Reopen this screen to try again, or paste the connection string."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht gestartet werden. Öffne diesen Bildschirm erneut, um es noch einmal zu versuchen, oder füge den Verbindungsstring ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la cámara. Vuelve a abrir esta pantalla para reintentarlo o pega la cadena de conexión."
          }
        }
      }
    },
    "add_wallet_title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet verbinden"
