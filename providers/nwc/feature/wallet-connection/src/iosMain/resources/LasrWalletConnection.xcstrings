      }
    },
    "connect_wallet_warning_heading": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Verbinden überprüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before connecting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa antes de conectar"
          }
        }
      }
    },
    "connect_wallet_warning_legacy_nip04": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet unterstützt nur die veraltete NIP-04-Verschlüsselung. Anfragen funktionieren, aber die Verschlüsselung ist schwächer als NIP-44."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet only supports legacy NIP-04 encryption. Requests will work, but encryption is weaker than NIP-44."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera solo admite el cifrado heredado NIP-04. Las solicitudes funcionarán, pero el cifrado es más débil que NIP-44."
          }
        }
      }
    },
    "connect_wallet_warning_legacy_nip04_default": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet hat kein Verschlüsselungsverfahren angekündigt. Wir nehmen die veraltete NIP-04-Verschlüsselung an, die schwächeren Schutz als NIP-44 bietet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet did not advertise an encryption scheme. We'll assume legacy NIP-04, which offers weaker protection than NIP-44."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera no anunció un esquema de cifrado. Asumiremos NIP-04 heredado, que ofrece una protección más débil que NIP-44."
          }
        }
      }
    },
    "connect_wallet_warning_missing_lookup_invoice": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet kündigt lookup_invoice nicht an. %1$@ benötigt die Methode, um verzögerte Zahlungen sicher zu klären."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet does not advertise lookup_invoice. %1$@ needs it to safely resolve delayed payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera no anuncia lookup_invoice. %1$@ lo necesita para resolver pagos demorados de forma segura."
          }
        }
      }
    },
    "connect_wallet_warning_missing_nip44": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet kündigt keine moderne NIP-44-Verschlüsselung an. Falls verfügbar, verwenden wir die weniger sichere Legacy-Verschlüsselung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet does not advertise modern NIP-44 encryption. We'll use legacy encryption if available, which is less secure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera no anuncia cifrado NIP-44 moderno. Usaremos el cifrado heredado si está disponible, que es menos seguro."
          }
        }
      }
    },
    "connect_wallet_warning_missing_pay_invoice": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet kündigt die Funktion pay_invoice nicht an. Zahlungen werden fehlschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet does not advertise the pay_invoice capability. Payments will fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera no anuncia la capacidad pay_invoice. Los pagos fallarán."
          }
        }
      }
    },
    "error_invalid_wallet_uri": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet-URI ist ungültig. Bitte überprüfe sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet URI isn't valid. Please double-check and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URI de la billetera no es válida. Verifícala e inténtalo de nuevo."
          }
        }
      }
    },
    "error_relay_connection_failed": {
      "extractionState": "stale",
      "localizations": {
        "de": {
