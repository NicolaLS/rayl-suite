          }
        }
      }
    },
    "error_wallet_already_connected": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenne deine aktuelle Wallet, bevor du eine andere verbindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect your current wallet before connecting another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta tu billetera actual antes de conectar otra."
          }
        }
      }
    },
    "keyboard_done": {
      "extractionState": "stale",
