    "spark_wallet_reconnect_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat die Wiederherstellungsphrase weiterhin sicher gespeichert. Prüfe deine Internetverbindung und versuche es erneut oder entferne die Wallet aus %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ still has the recovery phrase securely stored. Check your internet connection and retry, or remove the wallet from %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ todavía tiene guardada la frase de recuperación de forma segura. Revisa tu conexión a internet y vuelve a intentarlo, o quita la billetera de %1$@."
          }
        }
      }
    },
