{
  "sourceLanguage": "en",
  "strings": {
    "spark_error_missing_wallet_connection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a wallet to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde zuerst eine Wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una billetera para continuar."
          }
        }
      }
    },
    "spark_error_payment_rejected_generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment was rejected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung wurde abgewiesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago fue rechazado."
          }
        }
      }
    },
    "spark_error_payment_rejected_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment was rejected: %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung wurde abgewiesen: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago fue rechazado: %1$@"
          }
        }
      }
    },
    "spark_error_payment_unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to confirm this payment. Verify its status before paying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zahlung konnte nicht bestätigt werden. Prüfe ihren Status, bevor du erneut bezahlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar este pago. Verifica su estado antes de volver a pagar."
          }
        }
      }
    },
    "spark_error_relay_connection_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to wallet. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Wallet fehlgeschlagen. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar a la billetera. Inténtalo de nuevo."
          }
        }
      }
    },
    "spark_transaction_fee": {
      "localizations": {
