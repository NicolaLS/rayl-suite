{
  "sourceLanguage": "en",
  "strings": {
    "spark_settings_wallet_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery phrase stored securely on this device"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsphrase sicher auf diesem Gerät gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frase de recuperación guardada de forma segura en este dispositivo"
          }
        }
      }
    },
    "spark_settings_wallet_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spark wallet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spark-Wallet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Billetera Spark"
          }
        }
      }
    },
    "spark_choose_another_wallet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another wallet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Wallet wählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir otra billetera"
          }
        }
      }
    },
    "spark_session_close_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not close the wallet session. Retry before choosing another wallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet-Sitzung konnte nicht geschlossen werden. Versuche es erneut, bevor du eine andere Wallet wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar la sesión de la billetera. Reintenta antes de elegir otra billetera."
          }
        }
      }
    },
    "spark_session_close_retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    }
  },
  "version": "1.0"
