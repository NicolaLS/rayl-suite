    "in_progress_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zahlung für diese Anfrage läuft noch. Zeige sie an, um eine doppelte Zahlung zu vermeiden, oder erstelle nur dann eine zusätzliche Zahlung, wenn du erneut bezahlen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A payment for this request is still in progress. Review it to avoid paying twice, or create an additional payment only if you intend to pay again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pago para esta solicitud sigue en curso. Revísalo para evitar pagar dos veces o crea un pago adicional solo si quieres volver a pagar."
          }
        }
      }
    },
