#!/usr/bin/env bash
# Rayl regtest bank. Builds the tool on first use or after source changes, then runs it.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
jar="$here/build/install/regtest/lib/regtest.jar"

if [[ ! -f "$jar" ]] || [[ -n "$(find "$here/src" "$here/build.gradle.kts" -newer "$jar" -print -quit)" ]]; then
  "$root/gradlew" --quiet --project-dir "$root" :tools:regtest:installDist >&2
fi

RAYL_REGTEST_HOME="${RAYL_REGTEST_HOME:-$here/.local}" exec "$here/build/install/regtest/bin/regtest" "$@"
